---
import type { DeviceStatus } from '../server/types'

interface Props {
    status: DeviceStatus
}

const { status } = Astro.props
const isOn = status === 'encendido'
const isBooting = status === 'arrancando'
const canWake = !isOn && !isBooting
---

{
    isOn && (
        <button
            disabled
            class="border-on/30 bg-on/5 text-on/70 w-full cursor-default rounded-lg border px-4 py-2 text-sm font-medium"
        >
            ✓ Encendido
        </button>
    )
}
{
    isBooting && (
        <button class="border-border text-text-muted hover:text-text w-full rounded-lg border px-4 py-2 text-sm transition">
            Reintentar
        </button>
    )
}
{
    canWake && (
        <button class="border-boot/40 bg-boot/10 text-boot hover:bg-boot/20 hover:shadow-glow-boot w-full rounded-lg border px-4 py-2 text-sm font-medium transition">
            ⚡ Encender
        </button>
    )
}
