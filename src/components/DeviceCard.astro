---
import type { DeviceView } from '../lib/mock-devices'
import { STATUS_META } from '../lib/device-status'
import StatusPill from './StatusPill.astro'
import WakeButton from './WakeButton.astro'

interface Props {
    device: DeviceView
}

const { device } = Astro.props
const meta = STATUS_META[device.status]
const isBooting = device.status === 'arrancando'
const isUnknown = device.status === 'desconocido'
---

<article class={`bg-surface relative flex flex-col rounded-[var(--radius-card)] border p-5 transition ${meta.glow}`}>
    <div class="flex items-center justify-between">
        <StatusPill status={device.status} />
        <button
            class="text-text-muted hover:bg-surface-2 hover:text-text rounded-md px-1.5 transition"
            aria-label={`Acciones para ${device.name}`}
        >
            ⋯
        </button>
    </div>

    <h3 class="text-text mt-3 text-base font-semibold">{device.name}</h3>
    <p class="text-text-muted mt-0.5 font-mono text-sm">{device.ip ?? 'Sin IP'}</p>

    {isBooting && <p class="text-boot mt-0.5 font-mono text-xs">Paquete enviado · {device.boot} · esperando</p>}
    {!isBooting && <p class="text-text-muted/60 mt-0.5 font-mono text-xs">{device.mac}</p>}

    <div class="mt-4">
        <WakeButton status={device.status} />
    </div>

    {isUnknown && <p class="text-unknown mt-2 text-xs">No se puede comprobar el estado</p>}
</article>
