---
interface Props {
    onCount: number
    offCount: number
    lastChecked: string
}

const { onCount, offCount, lastChecked } = Astro.props
---

<div class="mt-8 flex items-end justify-between">
    <div>
        <h2 class="text-xl font-semibold">Equipos</h2>
        <p class="text-text-muted mt-1 text-sm">Última comprobación: {lastChecked}</p>
    </div>
    <p class="text-text-muted text-sm">
        <span class="text-on">{onCount} encendidos</span> · <span class="text-off">{offCount} apagados</span>
    </p>
</div>
