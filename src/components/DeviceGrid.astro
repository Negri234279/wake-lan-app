---
import type { DeviceView } from '../lib/mock-devices'
import DeviceCard from './DeviceCard.astro'

interface Props {
    devices: DeviceView[]
}

const { devices } = Astro.props
---

<section class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {devices.map((device) => <DeviceCard device={device} />)}
</section>
