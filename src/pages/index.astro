---
import Layout from '../layouts/Layout.astro'
import AppHeader from '../components/AppHeader.astro'
import DashboardSummary from '../components/DashboardSummary.astro'
import DeviceGrid from '../components/DeviceGrid.astro'
import { MOCK_DEVICES } from '../lib/mock-devices'

// Vista de estilado (Fase 4 pendiente): compone el dashboard con datos mock.
---

<Layout title="WakeLAN">
    <main class="mx-auto max-w-6xl px-4 py-8">
        <AppHeader />
        <DashboardSummary onCount={1} offCount={1} lastChecked="hace 12 s" />
        <DeviceGrid devices={MOCK_DEVICES} />
    </main>
</Layout>
