{
    "name": "wake-lan-app",
    "type": "module",
    "version": "0.0.1",
    "description": "Wake computers on your LAN via Wake-on-LAN, with live TCP/ICMP status detection.",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "start": "node ./dist/server/entry.mjs",
        "astro": "astro",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "docker:dev": "docker compose --profile dev up --build",
        "docker:staging": "docker compose --profile staging up --build -d",
        "docker:prod": "docker compose --profile prod up --build -d"
    },
    "dependencies": {
        "@astrojs/node": "11.0.3",
        "@astrojs/preact": "6.0.2",
        "@tailwindcss/vite": "4.3.3",
        "astro": "^7.1.6",
        "preact": "10.29.8",
        "tailwindcss": "4.3.3"
    },
    "devDependencies": {
        "@types/node": "26.1.2",
        "prettier": "3.9.6",
        "prettier-plugin-astro": "0.14.1",
        "prettier-plugin-tailwindcss": "0.8.1"
    }
}
